# ==============================================================================
# AfriLink Frontend Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development overrides.
# In production, configure these variables in your hosting provider (e.g. Vercel, Railway, AWS Amplify).

# ------------------------------------------------------------------------------
# 1. NestJS REST API Gateway Configuration
# ------------------------------------------------------------------------------
# Base URL for the AfriLink NestJS REST API.
# Production: https://api.afrilink.africa/v1
# Local Dev Default: http://localhost:4000/api/v1
# When unreachable or not configured, the frontend gracefully uses local mock handlers.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# ------------------------------------------------------------------------------
# 2. WebSocket Real-Time Messaging Gateway Configuration
# ------------------------------------------------------------------------------
# URL for the real-time bidirectional WebSocket gateway (/ws/messaging).
# Production: wss://api.afrilink.africa/ws/messaging
# Local Dev Default: ws://localhost:4000/ws/messaging
# When disconnected, the client automatically applies exponential backoff (1s -> 2s -> 4s -> 8s -> 10s max)
# and seamlessly activates a 10-second REST polling fallback.
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws/messaging

# ------------------------------------------------------------------------------
# 3. Environment & Application Metadata
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME="AfriLink"
NEXT_PUBLIC_APP_URL=http://localhost:3000
